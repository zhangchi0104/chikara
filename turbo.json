{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["AUTH_*"],
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["@chikara/infrastructure#dev"],
      "persistent": true,
      "env": ["AUTH_*"]
    },
    "@chikara/infrastructure#dev": {
      "cache": false,
      "dependsOn": [],
      "persistent": false
    }
  }
}
