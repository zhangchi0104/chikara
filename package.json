{
  "name": "bun-turborepo-templates",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "test:e2e": "maestro test apps/Chikara/.maestro",
    "test:e2e:watch": "maestro test --continuous apps/Chikara/.maestro",
    "new:app": "turbo gen scaffold --args app",
    "new:lib": "turbo gen scaffold --args library",
    "new:service": "turbo gen service"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@turbo/gen": "^2.10.7",
    "@types/bun": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "hooks/*",
      "services/*",
      "configs/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@biomejs/biome": "2.5.6",
      "effect": "4.0.0-beta.102",
      "@effect/tsgo": "0.24.3",
      "@effect/vitest": "4.0.0-beta.102",
      "@effect/sql-pg": "4.0.0-beta.102",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "hono": "^4.13.0",
      "wrangler": "^4.120.0",
      "@types/bun": "^1.3.14",
      "vitest": "^4.1.10"
    }
  }
}
