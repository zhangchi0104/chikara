{
  "name": "bun-turborepo-templates",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@chikara/auth",
    "dev:auth": "bun run --cwd services/auth dev",
    "dev:dashboard": "bun run --cwd apps/auth-dashboard dev",
    "dev:gateway": "bun run --cwd services/gateway dev",
    "lint": "biome check .",
    "check": "turbo run check",
    "check-types": "turbo run check",
    "test": "turbo run test",
    "db:create": "bun run --cwd services/auth db:create:remote",
    "deploy:auth-dashboard": "bun run --cwd services/auth deploy && bun run --cwd apps/auth-dashboard deploy",
    "migrate": "bun run --cwd services/auth db:migrate:local",
    "prepare": "effect-tsgo patch",
    "test:e2e": "maestro test apps/Chikara/.maestro",
    "test:e2e:watch": "maestro test --continuous apps/Chikara/.maestro",
    "new:app": "turbo gen scaffold --args app",
    "new:lib": "turbo gen scaffold --args library",
    "new:service": "turbo gen service"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/tsgo": "catalog:",
    "@turbo/gen": "^2.10.7",
    "@types/bun": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "hooks/*",
      "services/*",
      "configs/*"
    ],
    "catalog": {
      "sst": "^4.17.1",
      "typescript": "^7.0.2",
      "@biomejs/biome": "2.5.6",
      "effect": "4.0.0-beta.102",
      "@effect/tsgo": "0.24.3",
      "@effect/vitest": "4.0.0-beta.102",
      "@effect/sql-pg": "4.0.0-beta.102",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "hono": "^4.13.0",
      "wrangler": "^4.120.1",
      "@types/bun": "^1.3.14",
      "@types/node": "24.13.3",
      "astro": "^7.2.1",
      "@astrojs/cloudflare": "^14.2.1",
      "@astrojs/check": "^0.9.10",
      "vitest": "^4.1.10"
    }
  }
}
