{
  "name": "@chikara/auth",
  "version": "0.0.1",
  "description": "Otakuma Auth OAuth 2.1 authorization server",
  "author": "Alex Zhang",
  "private": true,
  "type": "module",
  "exports": {
    "./dashboard-contract": "./src/dashboard/dashboard.models.ts"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --port 8788 --inspector-port 9230 --persist-to .wrangler/state",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface AuthCloudflareBindings",
    "db:create:remote": "bun ./scripts/create-d1.ts",
    "db:generate": "node ./node_modules/.bin/auth generate --config ./scripts/auth-schema.ts --output ./auth-schema.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply chikara-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply chikara-auth --remote",
    "dashboard:token": "bun run scripts/bootstrap-token.ts",
    "dashboard:token:remote": "bun run scripts/bootstrap-token.ts --remote",
    "check": "biome check . && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.26",
    "@better-auth/passkey": "1.6.26",
    "@repo/cloudflare": "workspace:*",
    "better-auth": "1.6.26",
    "effect": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.6.26",
    "miniflare": "5.20260804.1-alpha",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
