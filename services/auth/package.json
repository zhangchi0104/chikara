{
  "name": "@chikara/auth",
  "version": "0.0.1",
  "description": "Chikara OAuth 2.1 authorization server",
  "author": "Alex Zhang",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface AuthCloudflareBindings",
    "db:generate": "node ./node_modules/.bin/auth generate --config ./scripts/auth-schema.ts --output ./auth-schema.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply chikara-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply chikara-auth --remote",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.26",
    "better-auth": "1.6.26",
    "effect": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.6.26",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
