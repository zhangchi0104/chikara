{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": ["@repo/biome-config/biome.json"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "!src/bindings.generated.d.ts",
      "src/**/*.css",
      "*.json",
      "*.jsonc",
      "*.ts",
      "!worker-configuration.d.ts"
    ]
  }
}
