---
import AuthLayout from "../layouts/AuthLayout.astro";
import { getAccountSession, getBootstrapStatus } from "../lib/auth.js";
import { authenticatedLanding } from "../lib/navigation.js";

const status = await getBootstrapStatus(Astro.request);
if (!status.data) return Astro.redirect("/bootstrap");
const session = await getAccountSession(Astro.request);
if (session.data) {
  const landing = authenticatedLanding(session.data);
  return Astro.redirect(landing);
}
---

<AuthLayout title="Welcome back" description="Sign in to your Otakuma Auth account.">
  <form class="auth-form" action="/actions/auth/sign-in/email" method="post" data-enhance data-next="/">
    <input type="hidden" name="_returnTo" value="/" />
    <input type="hidden" name="_boolean" value="rememberMe" />
    <label class="field">
      <span>Email address</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label class="field">
      <span>Password</span>
      <input name="password" type="password" autocomplete="current-password" required />
    </label>
    <label class="checkbox">
      <input name="rememberMe" type="checkbox" checked />
      <span>Keep me signed in on this device</span>
    </label>
    <button class="button button-primary" type="submit">Sign in</button>
    <div class="auth-divider" aria-hidden="true"><span>or</span></div>
    <button class="button" type="button" data-passkey-sign-in aria-describedby="passkey-sign-in-message">Use a passkey</button>
    <p class="warning-box" id="passkey-sign-in-message" data-passkey-error role="alert" hidden></p>
  </form>
</AuthLayout>
<script src="../scripts/auth.ts"></script>
