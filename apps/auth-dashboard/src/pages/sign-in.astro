---
import AuthLayout from "../layouts/AuthLayout.astro";
import { getBootstrapStatus, getDashboardSession } from "../lib/auth.js";

const status = await getBootstrapStatus(Astro.request);
if (!status.data) return Astro.redirect("/bootstrap");
const session = await getDashboardSession(Astro.request);
if (session.data) return Astro.redirect("/apis");
---

<AuthLayout title="Welcome back" description="Sign in with the superuser account to manage Chikara identity.">
  <form class="auth-form" action="/actions/auth/sign-in/email" method="post" data-enhance data-next="/apis">
    <input type="hidden" name="_returnTo" value="/apis" />
    <input type="hidden" name="_boolean" value="rememberMe" />
    <label class="field">
      <span>Email address</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label class="field">
      <span>Password</span>
      <input name="password" type="password" autocomplete="current-password" required />
    </label>
    <label class="checkbox">
      <input name="rememberMe" type="checkbox" checked />
      <span>Keep me signed in on this device</span>
    </label>
    <button class="button button-primary" type="submit">Sign in to dashboard</button>
    {Astro.url.searchParams.has("error") && <p class="warning-box">This account does not have superuser access.</p>}
  </form>
</AuthLayout>
