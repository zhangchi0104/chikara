---
import AuthLayout from "../layouts/AuthLayout.astro";
import { getTwoFactorChallenge } from "../lib/auth.js";
import { safeLocalPath } from "../lib/navigation.js";

const requestedReturnTo = Astro.url.searchParams.get("returnTo");
const returnTo = safeLocalPath(requestedReturnTo, "/");
const challenge = await getTwoFactorChallenge(Astro.request);
if (!challenge.data) return Astro.redirect("/sign-in");
const methods = challenge.data;
const passkey = methods.includes("passkey");
const totp = methods.includes("totp");
---

<AuthLayout title="Verify your sign-in" description="Complete one of the enrolled verification methods for this account.">
  <div class="auth-form">
    {passkey && (
      <>
        <p class="form-note">Use a passkey registered to the account that just passed password verification.</p>
        <button class="button button-primary" type="button" data-passkey-verification data-next={returnTo} data-unavailable={totp ? "Passkey verification is unavailable in this browser. Use another enrolled method." : "Passkey verification is unavailable in this browser. Restart sign-in on a device with passkey support."} aria-describedby="passkey-verification-message">Use a passkey</button>
        <p class="warning-box" id="passkey-verification-message" data-passkey-verification-error role="alert" hidden></p>
      </>
    )}
    {passkey && totp && <div class="auth-divider" aria-hidden="true"><span>or</span></div>}
    {totp && (
      <>
        <p class="form-note">Enter the six-digit code from your authenticator app. The code expires quickly and can only be used once.</p>
        <form action="/actions/auth/two-factor/verify-totp" method="post" data-enhance data-next={returnTo}>
          <input type="hidden" name="_returnTo" value={returnTo} />
          <label class="field"><span>Authenticator code</span><input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required autofocus /></label>
          <button class="button button-primary" type="submit">Verify and continue</button>
        </form>
        <div class="auth-divider" aria-hidden="true"><span>or</span></div>
        <form action="/actions/auth/two-factor/verify-backup-code" method="post" data-enhance data-next={returnTo}>
          <input type="hidden" name="_returnTo" value={returnTo} />
          <label class="field"><span>Recovery code</span><input name="code" autocomplete="off" spellcheck="false" required /></label>
          <button class="button" type="submit">Use a recovery code</button>
        </form>
      </>
    )}
    <p class="form-note">If you no longer have an enrolled method, ask the Otakuma Auth administrator to help secure the account again.</p>
  </div>
</AuthLayout>
<script src="../scripts/passkey-second-factor.ts"></script>
