---
import { dashboardQueries } from "../lib/auth.js";
import { authenticatedLanding } from "../lib/navigation.js";

const status = await dashboardQueries.bootstrapStatus(Astro.request);
if (!status.data) return Astro.redirect("/bootstrap");
const session = await dashboardQueries.accountSession(Astro.request);
if (!session.data) return Astro.redirect("/sign-in");
return Astro.redirect(authenticatedLanding(session.data));
---
