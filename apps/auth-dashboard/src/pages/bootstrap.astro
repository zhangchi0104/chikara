---
import AuthLayout from "../layouts/AuthLayout.astro";
import { dashboardQueries } from "../lib/auth.js";
import { operationLocation } from "../lib/dashboard-operations.js";

const status = await dashboardQueries.bootstrapStatus(Astro.request);
if (status.data) return Astro.redirect("/sign-in");
const bootstrapAction = operationLocation("bootstrap", { returnTo: "/sign-in" });
---

<AuthLayout title="Create the superuser" description="Use the one-time token generated by the auth Worker. This step can only succeed once.">
  <form class="auth-form" action={bootstrapAction} method="post" data-enhance data-next="/sign-in">
    <label class="field">
      <span>Full name</span>
      <input name="name" autocomplete="name" required maxlength="100" />
    </label>
    <label class="field">
      <span>Email address</span>
      <input name="email" type="email" autocomplete="email" required maxlength="320" />
    </label>
    <label class="field">
      <span>Password</span>
      <input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" />
      <small>Use at least 12 characters.</small>
    </label>
    <label class="field">
      <span>One-time bootstrap token</span>
      <input name="token" type="password" autocomplete="off" required minlength="20" />
      <small>Generate one with <span class="code">bun run --cwd services/auth dashboard:token</span>.</small>
    </label>
    <button class="button button-primary" type="submit">Create superuser</button>
    <p class="form-note">The token expires after 15 minutes and is consumed atomically when this account is created.</p>
  </form>
</AuthLayout>
