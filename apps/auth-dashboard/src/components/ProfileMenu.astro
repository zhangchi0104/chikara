---
import Icon from "./Icon.astro";

interface ProfileMenuUser {
  readonly email: string;
  readonly name: string;
}

interface Props {
  compact?: boolean;
  compactOnMobile?: boolean;
  current?: boolean;
  id: string;
  label: string;
  mobilePlacement?: "bottom-right";
  tone?: "dark" | "light";
  user: ProfileMenuUser;
}

const {
  compact = false,
  compactOnMobile = false,
  current = false,
  id,
  label,
  mobilePlacement,
  tone = "light",
  user,
} = Astro.props;
const initial = user.name.trim().slice(0, 1).toUpperCase() || "O";
const isDark = tone === "dark";
const copyVisibilityClasses = {
  hidden: compact,
  "mobile:hidden": compactOnMobile,
};
const triggerToneClasses = isDark
  ? "text-[#eef2f8] hover:border-[#344158] hover:bg-[#1b273b] aria-expanded:border-[#344158] aria-expanded:bg-[#1b273b]"
  : "text-ink hover:border-line hover:bg-[#f6f7f9] aria-expanded:border-line aria-expanded:bg-[#f6f7f9]";
const labelToneClasses = isDark ? "text-[#aeb8c9]" : "text-ink-soft";
const popoverPlacementClasses = isDark
  ? "bottom-[calc(100%+10px)] left-0"
  : "top-[calc(100%+10px)] right-0";
const menuItemClasses =
  "flex min-h-10 w-full items-center gap-2.5 rounded-lg border-0 bg-transparent px-2.5 py-0 text-left font-[650] text-ink hover:bg-[#f1f3f6] aria-[current=page]:bg-[#f1f3f6] [&[aria-current=page]_svg]:text-signal";
---

<div
  class:list={[
    "relative min-w-0",
    compact ? "w-[46px]" : "w-full",
    { "mobile:w-[46px]": compactOnMobile },
  ]}
  data-profile-menu
>
  <button
    class:list={[
      "group flex min-h-[46px] items-center gap-2.5 rounded-[10px] border border-transparent bg-transparent text-left",
      compact ? "w-[46px] p-[5px]" : "w-full p-1.5",
      triggerToneClasses,
      { "mobile:w-[46px] mobile:p-[5px]": compactOnMobile },
    ]}
    type="button"
    aria-controls={id}
    aria-expanded="false"
    aria-haspopup="menu"
    aria-label={`Open account menu for ${user.name}`}
    data-profile-menu-trigger
  >
    <span class="avatar" aria-hidden="true">{initial}</span>
    <span
      class:list={["grid min-w-0 flex-1", copyVisibilityClasses]}
    >
      <strong class="truncate text-[13px]">{user.name}</strong>
      <small class:list={["truncate text-[11px]", labelToneClasses]}>
        {label}
      </small>
    </span>
    <span
      class:list={[
        "grid shrink-0 text-ink-soft transition-transform duration-[160ms] group-aria-expanded:rotate-180",
        copyVisibilityClasses,
      ]}
      aria-hidden="true"
    >
      <Icon name="chevron" size={16} />
    </span>
  </button>
  <div
    class:list={[
      "absolute z-30 max-h-[min(420px,calc(100dvh-32px))] w-[min(260px,calc(100vw-32px))] overflow-y-auto rounded-xl border border-line bg-paper text-ink shadow-[0_18px_42px_rgba(23,32,51,0.2)] [&[hidden]]:hidden",
      popoverPlacementClasses,
      {
        "mobile:top-[calc(100%+10px)] mobile:right-0 mobile:bottom-auto mobile:left-auto mobile:max-h-[calc(100dvh-92px)]":
          mobilePlacement === "bottom-right",
      },
    ]}
    id={id}
    role="menu"
    aria-label="Account"
    data-profile-menu-popover
    hidden
  >
    <div class="grid gap-0.5 border-b border-line px-[15px] py-3.5">
      <strong class="truncate text-[14px]">{user.name}</strong>
      <small class="truncate text-[12px] text-ink-soft">{user.email}</small>
    </div>
    <div class="grid gap-[3px] p-1.5">
      <a class={menuItemClasses} href="/profile" role="menuitem" aria-current={current ? "page" : undefined}>
        <Icon name="user" />
        <span>Profile</span>
      </a>
      <form class="contents" action="/actions/auth/sign-out" method="post">
        <input type="hidden" name="_returnTo" value="/sign-in" />
        <button class={menuItemClasses} type="submit" role="menuitem">
          <Icon name="logout" />
          <span>Log out</span>
        </button>
      </form>
    </div>
  </div>
</div>
