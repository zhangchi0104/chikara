---
import Icon from "./Icon.astro";
---

<dialog class="dialog" data-credential-dialog aria-labelledby="credential-dialog-title" aria-describedby="credential-dialog-description">
  <div class="dialog-head">
    <div>
      <h2 id="credential-dialog-title">Store this credential now</h2>
      <p id="credential-dialog-description">For security, Otakuma Auth will not show it again.</p>
    </div>
  </div>
  <div class="dialog-body">
    <div class="warning-box">Copy this value into your application's secure configuration. Never commit it to source control.</div>
    <p class="credential" data-credential></p>
    <div class="dialog-actions">
      <button class="button" type="button" data-copy><Icon name="copy" />Copy</button>
      <button class="button button-primary" type="button" data-acknowledge>I stored it safely</button>
    </div>
  </div>
</dialog>
