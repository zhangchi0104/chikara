{
  "name": "@chikara/auth-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "biome check . && astro check",
    "cf-typegen": "wrangler types ./src/bindings.generated.d.ts --env-interface AuthDashboardCloudflareBindings",
    "deploy": "astro build && wrangler deploy",
    "dev": "bun run --cwd ../../services/auth db:migrate:local && astro dev",
    "preview": "astro build && astro preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "catalog:",
    "@astrojs/react": "^6.0.2",
    "@chikara/auth": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "catalog:",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@biomejs/biome": "catalog:",
    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
